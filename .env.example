# Copia este archivo como .env.local (no se sube a GitHub) y rellena los valores de tu
# proyecto de DESARROLLO forja-dev: Supabase → Project Settings → API.
# Solo la URL y la clave pública (anon / publishable). NUNCA la service_role / secret.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: site key PÚBLICA de Cloudflare Turnstile (vacía = sin captcha). Nunca la secret key.
EXPO_PUBLIC_CAPTCHA_SITEKEY=
